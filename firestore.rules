rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function owner(uid) { return request.auth != null && request.auth.uid == uid; }
  match /users/{uid}/courses/{courseId} {
   allow read, delete: if owner(uid);
   allow create, update: if owner(uid)
    && request.resource.data.keys().hasOnly(['name','revision','chunks','savedAt','day','holes','previous','previousChunks','golfer','xp'])
    && request.resource.data.name is string && request.resource.data.name.size() <= 64
    && request.resource.data.revision is string && request.resource.data.chunks is int
    && request.resource.data.chunks > 0 && request.resource.data.chunks <= 300;
   match /snapshots/{snapshotId} {
    allow read, delete: if owner(uid);
    allow create: if owner(uid) && request.resource.data.keys().hasOnly(['data'])
      && request.resource.data.data is string && request.resource.data.data.size() <= 400000;
    allow update: if false;
   }
  }
 }
}
